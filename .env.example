# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# Set these in Render Dashboard -> Environment, or in a local (gitignored) server/.env
# ==========================================
NODE_ENV=production
PORT=10000
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/shutter_stripes?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://safari-client-topaz.vercel.app
# Extra allowed origins for CORS, comma-separated (optional).
CLIENT_URLS=

# Optional transactional mail via Resend. Leave blank to disable notifications.
RESEND_API_KEY=
MAIL_FROM=Shutter and Stripes <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=

# Only needed to run `npm run seed` locally. The seed script refuses to run without
# them, so no account password is committed to the repo. Choose your own.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
